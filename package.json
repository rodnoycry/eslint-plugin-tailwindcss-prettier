{
    "name": "eslint-plugin-tailwindcss-prettier",
    "version": "0.2.0",
    "description": "ESLint plugin for ordering Tailwind CSS classes",
    "main": "lib/index.js",
    "files": [
        "lib",
        "CHANGELOG.md"
    ],
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    },
    "scripts": {
        "test": "node --test",
        "lint": "eslint .",
        "version": "npx changeset version",
        "release": "npx changeset publish && npx changeset tag"
    },
    "keywords": [
        "eslint",
        "eslintplugin",
        "eslint-plugin",
        "tailwind",
        "tailwindcss",
        "prettier"
    ],
    "author": "Nikita Leontev",
    "license": "MIT",
    "dependencies": {
        "prettier": "^3.0.0",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "synckit": "^0.12.3"
    },
    "peerDependencies": {
        "eslint": ">=8.40.0"
    },
    "engines": {
        "node": ">=20.19"
    },
    "devDependencies": {
        "@changesets/cli": "^2.31.0",
        "eslint": "^10.14.0",
        "tailwindcss": "^4.3.5"
    },
    "homepage": "https://github.com/rodnoycry/eslint-plugin-tailwindcss-prettier#readme",
    "bugs": {
        "url": "https://github.com/rodnoycry/eslint-plugin-tailwindcss-prettier/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/rodnoycry/eslint-plugin-tailwindcss-prettier.git"
    }
}
