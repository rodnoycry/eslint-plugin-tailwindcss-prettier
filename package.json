{
    "name": "eslint-plugin-tailwindcss-prettier",
    "version": "0.1.0",
    "description": "ESLint plugin for ordering Tailwind CSS classes",
    "main": "lib/index.js",
    "files": [
        "lib",
        "CHANGELOG.md"
    ],
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    },
    "scripts": {
        "lint": "eslint .",
        "version": "npx changeset version",
        "release": "npx changeset publish && npx changeset tag"
    },
    "keywords": [
        "eslint",
        "eslintplugin",
        "eslint-plugin",
        "tailwind",
        "tailwindcss",
        "prettier"
    ],
    "author": "Nikita Leontev",
    "license": "MIT",
    "dependencies": {
        "prettier-plugin-tailwindcss": "^0.6.8",
        "synckit": "^0.9.2"
    },
    "peerDependencies": {
        "eslint": ">=7"
    },
    "devDependencies": {
        "@changesets/cli": "^2.31.0",
        "eslint": "^8.0.0"
    },
    "homepage": "https://github.com/rodnoycry/eslint-plugin-tailwindcss-prettier#readme",
    "bugs": {
        "url": "https://github.com/rodnoycry/eslint-plugin-tailwindcss-prettier/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/rodnoycry/eslint-plugin-tailwindcss-prettier.git"
    }
}
